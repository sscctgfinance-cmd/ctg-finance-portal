#!/bin/sh
# Enforce the PR-only rule on CTG-Business (origin).
#
# Direct pushes to main are how this repo has always worked, so the habit is the risk — a convention
# written in a doc does not survive a hurried fix. This makes the wrong move fail loudly instead.
#
# `publish` (sscctgfinance-cmd) is deliberately exempt: it is not a development remote, it is the
# GitHub Pages + edge-function deploy target, and publishing IS a push of main.
#
# Escape hatch, for when you genuinely mean it:  git push --no-verify origin main

remote_name="$1"

if [ "$remote_name" = "origin" ]; then
  while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
      refs/heads/main|refs/heads/master)
        echo "" >&2
        echo "  ✋ Direct push to origin/$(basename "$remote_ref") is blocked — this repo is PR-only." >&2
        echo "" >&2
        echo "  Do this instead:" >&2
        echo "    git switch -c <branch>          # if you are still on main" >&2
        echo "    git push -u origin <branch>" >&2
        echo "    then open the PR link git prints" >&2
        echo "" >&2
        echo "  Publishing to the live site is a separate, still-allowed step:" >&2
        echo "    git push publish main" >&2
        echo "" >&2
        exit 1
        ;;
    esac
  done
fi

exit 0
